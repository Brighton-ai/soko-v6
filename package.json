  "description": "Shule — school management for Kenyan schools. Marketing site.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" && npm run test:contract",
    "test:app": "node --test \"test/*.test.js\"",
