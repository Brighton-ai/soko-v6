{
  "name": "shule",
  "version": "0.1.0",
  "description": "Shule \u2014 school management for Kenyan schools. Marketing site.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\" && npm run test:contract",
    "test:app": "node --test \"test/*.test.js\"",
    "test:contract": "node --test \"test/contract/*.contract.test.js\"",
    "test:live": "SHULE_BACKEND=live node --test \"test/contract/*.contract.test.js\"",
    "shell:check": "node tools/shell.mjs --check",
    "counts": "node tools/counts.mjs",
    "routes": "python3 dev/routes.py",
    "routes:probe": "node dev/probe-routes.mjs",
    "routes:shadow": "node dev/shadowed.mjs",
    "db:columns": "python3 dev/check-columns.py",
    "audit": "node dev/shadowed.mjs && python3 dev/check-columns.py && node dev/probe-routes.mjs",
    "build": "node tools/build.mjs",
    "build:demo": "node tools/build.mjs --demo --out dist-demo",
    "start": "node server.mjs",
    "browser:check": "node dev/browser-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brighton-ai/soko-v6.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Brighton-ai/soko-v6/issues"
  },
  "homepage": "https://github.com/Brighton-ai/soko-v6#readme",
  "devDependencies": {
    "cheerio": "^1.2.0",
    "jsdom": "^30.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
